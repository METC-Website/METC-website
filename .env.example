# Cloudflare Access Service Token used only by the local Worker uploader.
# Never use a NEXT_PUBLIC_ prefix for either credential.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Worker write endpoint and public read endpoint.
R2_WORKER_UPLOAD_URL=https://upload.sciemetc.com
NEXT_PUBLIC_RESOURCE_BASE_URL=https://assets.sciemetc.com

# Local resource pipeline input. This directory contains approved source files
# and generated public derivatives; it is never uploaded wholesale to Vercel.
METC_RESOURCE_ROOT=/absolute/path/to/resources/METC
